theta_names <- names(s$hyperpar)
t1 <- s$hyperpar[grep("Theta1", theta_names)] # log(tau)
t2 <- s$hyperpar[grep("Theta2", theta_names)] # log(eta1)
t3 <- s$hyperpar[grep("Theta3", theta_names)] # log(eta2)
# Apply the Inverse Transformations
tau_b <- exp(t1)
eta1 <- exp(t2)
eta2 <- exp(t3)
eta_sum <- 1 + eta1 + eta2
alpha_unstruct <- eta1 / eta_sum # alpha1
alpha_struct   <- eta2 / eta_sum # alpha2
alpha_topo     <- 1 / eta_sum    # alpha3 (Topological)
return(c(tau = tau_b,
alpha_unstruct = alpha_unstruct,
alpha_struct = alpha_struct,
alpha_topo = alpha_topo))
}
# 3. Apply transformation to all samples
transformed_samples <- t(sapply(samples, get_params))
transformed_df <- as.data.frame(transformed_samples)
# 4. Calculate Summary Statistics
param_summary <- data.frame(
Parameter = colnames(transformed_df),
Mean = colMeans(transformed_df),
Median = apply(transformed_df, 2, median),
SD = apply(transformed_df, 2, sd),
Q0.025 = apply(transformed_df, 2, quantile, probs = 0.025),
Q0.975 = apply(transformed_df, 2, quantile, probs = 0.975)
)
# Print the readable summary
print(param_summary)
knitr::opts_chunk$set(echo = TRUE)
# Load necessary libraries
library(INLA)
library(sf)
library(spdep)
library(dplyr)
library(readr)
library(ggplot2)
library(Matrix)
library(MASS)   # For ginv()
# Set the base path to one leve up from the current path
current_path <- dirname(getwd())
# Set the state abbreviation
state_abb <- "WV"
print(paste("Current Path:", current_path))
# Load SVI TDA Data
tda_path <- file.path(current_path, "data", "processed_data", paste0("tda_summaries_2018_", state_abb, "_down.csv"))
svi_tda_data <- read_csv(tda_path, col_types = cols(STCNTY = col_character()))
# Load SMR Data
smr_path <- file.path(current_path, "data", "processed_data", paste0("smr_data_2018_", state_abb, ".csv"))
smr_data <- read_csv(smr_path, col_types = cols(FIPS = col_character()))
# Load Geometry Data (GDB)
geo_path <- file.path(current_path, "data", "raw_data", "SVI2018_US_county.gdb")
# Note: "layers" in GDB might vary, usually it's the main layer name.
# You can check layers with: st_layers(geo_path)
geo_data <- st_read(geo_path, quiet = TRUE)%>%
dplyr::select(FIPS, ST_ABBR) # Select only relevant columns to match your code
# Merge SMR and TDA data (Left join on FIPS = STCNTY)
combined_data <- smr_data %>%
left_join(svi_tda_data, by = c("FIPS" = "STCNTY"))
# Merge with Geometry (Left join on FIPS)
# Ensure we convert combined_data to an sf object
combined_data <- geo_data %>%
right_join(combined_data, by = "FIPS") %>%
filter(ST_ABBR == state_abb)
# Check shape
print(paste("Shape after adding AL column:", nrow(combined_data), ncol(combined_data)))
# Cleaning the processed data
# remove rows with zero observed deaths (removing missing data)
combined_data <- combined_data %>%
filter(observed_deaths > 0)
# identify islands (no neighbors) and remove them
nb <- poly2nb(combined_data, row.names = combined_data$FIPS)
islands <- which(card(nb) == 0)
if (length(islands) > 0) {
combined_data <- combined_data[-islands, ]
}
# drop rows FIPS starts with ('72', '78', '02', '15', '60')
combined_data <- combined_data %>%
filter(!substr(FIPS, 1, 2) %in% c('72', '78', '02', '15', '60'))
print(paste("Shape after cleaning:", nrow(combined_data)))
# mean standerdize the AL column
combined_data <- combined_data %>%
mutate(AL = scale(EP_POV_AL))
# Create a unique ID for the spatial random effect (INLA requires integer indices)
combined_data$ID_spatial <- 1:nrow(combined_data)
# INLA requires a graph object or file to define neighbors.
# This replaces libpysal.weights.Queen
# Create neighbor list (Queen contiguity)
nb <- poly2nb(combined_data, queen = TRUE)
# Convert to INLA graph file
nb2INLA("wv.graph", nb)
g <- inla.read.graph("wv.graph")
# Create a unique ID for the spatial random effect (INLA requires integer indices)
combined_data$ID_spatial <- 1:nrow(combined_data)
# 1. Create the neighbor list from your spatial data
# 'queen = TRUE' includes corners (standard for spatial polygons)
nb <- poly2nb(combined_data, queen = TRUE)
# 2. Convert neighbors to a binary adjacency matrix (W)
# style = "B" creates binary 1/0 weights
# zero.policy = TRUE prevents errors if you have islands
W <- nb2mat(nb, style = "B", zero.policy = TRUE)
W <- as(W, "dgCMatrix") # Convert to standard sparse matrix format
# 3. Create the Structural Precision Matrix (Q)
# Logic: Q_ii = Number of neighbors, Q_ij = -1 if neighbors
num_neighbors <- rowSums(W)
Q <- Diagonal(nrow(combined_data), num_neighbors) - W
Q_scaled =inla.scale.model(Q, constr = list(A = matrix(1,1,nrow(Q)), e = 0))
# INLA requires a graph object or file to define neighbors.
# This replaces libpysal.weights.Queen
# Convert to INLA graph file
nb2INLA("wv.graph", nb)
g <- inla.read.graph("wv.graph")
