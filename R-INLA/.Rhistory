# Define the custom BYM-T model
inla.rgeneric.bym_topological <- function(cmd = c("graph", "Q", "mu", "initial", "log.norm.const", "log.prior", "quit"), theta = NULL, args = NULL) {
# Access environment for variables passed in 'define' (like the Graph 'R')
envir = parent.env(environment())
# Helper function to interpret theta parameters
interpret.theta <- function() {
# tau_b: precision parameter
tau_b <- exp(theta[1L])
# Use softmax-like parameterization for alpha1, alpha2, alpha3
# to ensure they sum to 1 and are all positive
eta1 <- exp(theta[2L])
eta2 <- exp(theta[3L])
eta_sum <- 1 + eta1 + eta2
alpha1 <- eta1 / eta_sum  # unstructured
alpha2 <- eta2 / eta_sum  # structured
alpha3 <- 1 / eta_sum      # topological
return(list(
tau_b = tau_b,
alpha1 = alpha1,
alpha2 = alpha2,
alpha3 = alpha3
))
}
# R is now the PRE-SCALED matrix passed from args
R <- args$R
n <- nrow(R)
graph <- function() {
# The graph is based on the adjacency structure plus diagonal
# Return sparse matrix (upper triangular)
return(Q())
}
# Precision matrix Q(theta)
Q <- function() {
p <- interpret.theta()
# Retrieve pre-calculated matrices from environment
# Q_struct is the scaled ICAR matrix: scaling_factor * (Diagonal(rowSums(W)) - W)
# 1. Unstructured Part (alpha1) + Topological Part (alpha3)
# Note: Both are diagonal, so we sum their weights for efficiency
# Q_iid = tau * (alpha1 + alpha3) * I
# 2. Structured Part (alpha2)
# Q_besag = tau * alpha2 * Q_struct
# Combine:
# We use the pre-calculated 'I_n' and 'Q_struct' from environment
Q_val <- p$tau_b * ( (p$alpha1 + p$alpha3) * I_n + p$alpha2 * Q_struct )
return(inla.as.sparse(Q_val))
}
# Mean function
mu <- function() {
p <- interpret.theta()
# The topological component s_i enters as a mean shift
# mu_i = (1/sqrt(tau_b)) * sqrt(alpha3) * s_i
mean_vec <- sqrt(p$alpha3 / p$tau_b) * s_topo
return(mean_vec)
}
# Log normalizing constant
log.norm.const <- function() {
# Let INLA compute it from the Cholesky factorization
return(numeric(0))
}
# Log prior
log.prior <- function() {
p <- interpret.theta()
# Prior for tau_b: Gamma(a_tau, b_tau) with Jacobian
# Default: Gamma(1, 0.01) - weakly informative
log_prior_tau <- dgamma(p$tau_b, shape = prior_tau_a, rate = prior_tau_b,
log = TRUE) + theta[1L]
# Priors for alpha parameters through eta parameterization
# Use normal priors on theta[2] and theta[3]
log_prior_alpha1 <- dnorm(theta[2L], mean = 0, sd = prior_alpha_sd, log = TRUE)
log_prior_alpha2 <- dnorm(theta[3L], mean = 0, sd = prior_alpha_sd, log = TRUE)
val <- log_prior_tau + log_prior_alpha1 + log_prior_alpha2
return(val)
}
# Initial values
initial <- function() {
# tau_b: start with log(precision) = 4 (high precision)
# alphas: start with equal weights (theta[2]=theta[3]=0 gives approx equal split)
return(c(4, 0, 0))
}
# Quit function
quit <- function() {
return(invisible())
}
# Ensure theta is always defined
if (!length(theta)) theta <- initial()
# Execute the requested command
val <- do.call(match.arg(cmd), args = list())
return(val)
# sometimes this is useful, as argument 'graph' and 'quit'
# will pass theta=numeric(0) (or NULL in R-3.6...) as
# the values of theta are NOT
# required for defining the graph. however, this statement
# will ensure that theta is always defined.
}
# The Wrapper Function (CRITICAL) ---
define.bymt.model <- function(W, s_topo_vector, prior_tau = c(1, 0.01), prior_alpha_sd = 10) {
# A. Pre-calculate dimensions and Identity matrix
n <- nrow(W)
I_n <- Matrix::Diagonal(n)
# B. Pre-calculate Scaled ICAR Matrix
Q_struct =inla.scale.model(W, constr = list(A = matrix(1,1,n), e = 0))
# C. Define the rgeneric model
# We pass all necessary variables into the environment
model <- inla.rgeneric.define(inla.rgeneric.bym_topological,
W = W,
s_topo = s_topo_vector,
n = n,
I_n = I_n,
Q_struct = Q_struct,
prior_tau_a = prior_tau[1],
prior_tau_b = prior_tau[2],
prior_alpha_sd = prior_alpha_sd)
return(model)
}
# 1. Prepare the data
# Ensure 'idx' exists inside combined_data so the formula f(idx, ...) can find it
combined_data$idx <- 1:nrow(combined_data)
# 2. Define the model object
# FIX: Extract the 'AL' column using combined_data$AL
bymt_model <- define.bymt.model(W = Q, s_topo_vector = combined_data$AL)
# 3. Define Formula
formula <- observed_deaths ~ 1 + EP_POV_AV_ORI + f(idx, model = bymt_model)
# 4. Run INLA
# Ensure 'Y' and 'E' (expected) are actually columns in combined_data
# 4. Run INLA (Re-run with config = TRUE)
result <- inla(formula,
data = combined_data,
family = "poisson",
E = combined_data$expected_deaths,
control.predictor = list(compute = TRUE),
# --- ADD THIS SECTION ---
control.compute = list(config = TRUE,
dic = TRUE,    # (Optional) Good for model comparison
waic = TRUE)   # (Optional) Good for model comparison
)
summary(result)
# 1. Generate samples from the posterior distribution
# n = 1000 is usually sufficient for summary statistics
samples <- inla.posterior.sample(n = 1000, result)
# 2. Define a transformation function (Matches your interpret.theta logic)
get_params <- function(s) {
# Extract the latent hyperparameters
# Note: The names typically look like "Theta1 for idx", "Theta2 for idx"
# We find them by partial matching to be safe
theta_names <- names(s$hyperpar)
t1 <- s$hyperpar[grep("Theta1", theta_names)] # log(tau)
t2 <- s$hyperpar[grep("Theta2", theta_names)] # log(eta1)
t3 <- s$hyperpar[grep("Theta3", theta_names)] # log(eta2)
# Apply the Inverse Transformations
tau_b <- exp(t1)
eta1 <- exp(t2)
eta2 <- exp(t3)
eta_sum <- 1 + eta1 + eta2
alpha_unstruct <- eta1 / eta_sum # alpha1
alpha_struct   <- eta2 / eta_sum # alpha2
alpha_topo     <- 1 / eta_sum    # alpha3 (Topological)
return(c(tau = tau_b,
alpha_unstruct = alpha_unstruct,
alpha_struct = alpha_struct,
alpha_topo = alpha_topo))
}
# 3. Apply transformation to all samples
transformed_samples <- t(sapply(samples, get_params))
transformed_df <- as.data.frame(transformed_samples)
# 4. Calculate Summary Statistics
param_summary <- data.frame(
Parameter = colnames(transformed_df),
Mean = colMeans(transformed_df),
Median = apply(transformed_df, 2, median),
SD = apply(transformed_df, 2, sd),
Q0.025 = apply(transformed_df, 2, quantile, probs = 0.025),
Q0.975 = apply(transformed_df, 2, quantile, probs = 0.975)
)
# Print the readable summary
print(param_summary)
# 1. Generate samples from the posterior distribution
# n = 1000 is usually sufficient for summary statistics
samples <- inla.posterior.sample(n = 1000, result)
